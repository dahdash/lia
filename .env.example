# Liara API token (console.liara.ir/API)
LIARA_API_KEY=
LIARA_API_BASE=https://api.liara.ir
# Team id if the apps and balance belong to a Liara team (sent as ?teamID= like the CLI)
LIARA_TEAM_ID=

# LLM: boxapi token (https://boxapi.ir/docs/ai/), the default provider
BOX_API_TOKEN=
# Optional overrides for another OpenAI-compatible provider
# LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-5.4-mini

# Optional: folder with the local projects Lia may deploy (default: ./demo)
# LIA_PROJECTS_DIR=
